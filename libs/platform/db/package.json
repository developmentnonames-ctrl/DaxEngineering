{
  "name": "@dax/platform-db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "platform-db",
    "tags": [
      "scope:platform",
      "type:data"
    ],
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema/**/*.prisma",
          "{projectRoot}/prisma.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "options": {
          "command": "prisma generate",
          "cwd": "{projectRoot}"
        }
      },
      "prisma-validate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma validate",
          "cwd": "{projectRoot}"
        }
      },
      "prisma-lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsx tools/scripts/prisma-lint.ts libs/platform/db/prisma",
          "cwd": "{workspaceRoot}"
        }
      },
      "migrate-dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev",
          "cwd": "{projectRoot}"
        }
      },
      "migrate-deploy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate deploy && tsx scripts/apply-grants.ts",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "prisma-generate",
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "prisma-generate"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  }
}
