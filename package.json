{
  "name": "@dax/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "check": "nx sync && nx run-many -t lint typecheck test build && pnpm lint:copy && pnpm lint:prisma",
    "lint:copy": "tsx tools/scripts/copy-lint.ts",
    "lint:prisma": "tsx tools/scripts/prisma-lint.ts libs/platform/db/prisma",
    "db:up": "docker compose up -d",
    "db:down": "docker compose --profile files down",
    "files:up": "docker compose --profile files up -d",
    "db:migrate": "nx run platform-db:migrate-dev",
    "db:deploy": "nx run platform-db:migrate-deploy",
    "dev": "pnpm db:up && nx run-many -t dev -p api web admin --parallel=3 --output-style=stream",
    "dev:api": "nx serve api",
    "dev:web": "nx dev web",
    "dev:admin": "nx dev admin",
    "kill": "npx --yes kill-my-port@1.1.2 3100 4200 4300"
  },
  "private": true,
