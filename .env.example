# Local development only. Copy to `.env` (git-ignored).

DATABASE_URL=postgresql://dax_app:app-dev-only@localhost:5432/dax
MIGRATOR_DATABASE_URL=postgresql://dax_migrator:migrator-dev-only@localhost:5432/dax
SHADOW_DATABASE_URL=postgresql://dax_migrator:migrator-dev-only@localhost:5432/dax_shadow

API_PORT=3100
API_HOST=127.0.0.1
LOG_LEVEL=debug

API_INTERNAL_URL=http://127.0.0.1:3100

BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-in-dokploy
INTERNAL_TOKEN_WEB=dev-only-internal-token-web-0000000000
INTERNAL_TOKEN_ADMIN=dev-only-internal-token-admin-000000000
WEB_ORIGIN=http://localhost:4200
ADMIN_ORIGIN=http://localhost:4300

# RESEND_API_KEY=
# MAIL_FROM=

BOOTSTRAP_ADMIN_NAME=Dev Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=dev-only-admin-password

# File storage. Local MinIO from docker compose (dev only); Dokploy points these at Cloudflare R2.
S3_ENDPOINT=http://127.0.0.1:59000
S3_BUCKET=dax-dev
S3_ACCESS_KEY_ID=dax-dev-only
S3_SECRET_ACCESS_KEY=dax-dev-only-secret
S3_REGION=auto

# Dev-only key. Production keys live in Dokploy: k1:<base64 of 32 random bytes>
DATA_ENCRYPTION_KEYS=dev1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DATA_ENCRYPTION_ACTIVE_KEY=dev1
